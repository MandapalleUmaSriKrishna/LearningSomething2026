# Copy to backend/.env and adjust. Never commit real secrets.
APP_ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-value

APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=7

APP_DATABASE_URL=sqlite:///./data/app.db
APP_CORS_ORIGINS=http://localhost:5173

APP_MAX_UPLOAD_BYTES=26214400
APP_MAX_ROWS=200000
APP_MAX_COLUMNS=200

APP_LOGIN_RATE_LIMIT=10/minute
APP_TRAIN_RATE_LIMIT=20/hour
APP_DEFAULT_RATE_LIMIT=240/minute

APP_MAX_FAILED_LOGINS=5
APP_LOCKOUT_MINUTES=15

# Seeded only when the user table is empty; change the password right after first login.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!Admin123
